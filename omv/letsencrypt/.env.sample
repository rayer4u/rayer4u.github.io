# ==============================================================================
# acme.sh 证书中心环境变量配置样例
# ==============================================================================

# 通用证书导出目录 (默认存放到 omv/certs)
HOST_CERT_DIR=../certs

# 主域名与通知邮箱
DOMAIN=roybi.net
ACME_EMAIL=admin@roybi.net
TIME_ZONE=Asia/Shanghai

# ==============================================================================
# 云厂商 DNS API 凭据 (按需填写对应的厂商，acme.sh 会自动识别并记住)
# ==============================================================================

# 1. 腾讯云 DNSPod Token (用于 --dns dns_dp，即纯数字 ID + Token)
DP_Id=
DP_Key=

# 2. 腾讯云全局 API 密钥 (用于 --dns dns_tencent，即 AKID... 格式)
# Tencent_SecretId=
# Tencent_SecretKey=

# 2. 阿里云 (Aliyun DNS)
# Ali_Key=
# Ali_Secret=

# 3. Cloudflare
# CF_Token=
# CF_Account_ID=
# CF_Zone_ID=

# 4. 华为云 (Huawei Cloud)
# HUAWEICLOUD_Username=
# HUAWEICLOUD_Password=
# HUAWEICLOUD_DomainName=