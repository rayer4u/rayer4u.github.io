COMPOSE_PROJECT_NAME=omv

# ==============================================================================
# 硬件加速组件配置 (通过 detect-gpu-env.sh 自动探测或按需指定)
# ==============================================================================
# NVIDIA 独显机使用:
JELLYFIN_COMPOSE=docker-compose.jellyfin.nvidia.yml
PHOTO_COMPOSE=docker-compose.photo.nvidia.yml
# Intel 核显/独显 或 AMD APU/独显机使用:
# JELLYFIN_COMPOSE=docker-compose.jellyfin.dri.yml
# PHOTO_COMPOSE=docker-compose.photo.dri.yml

# 宿主机显卡设备组 GID (可通过 detect-gpu-env.sh 自动探测获取)
RENDER_GID=148
VIDEO_GID=44

# DRI 模式下 PhotoPrism 编码器类型 (Intel 核显/独显使用 intel；AMD RDNA2+ 使用 vulkan)
PHOTO_ENCODER=intel
PHOTO_INIT=intel

# 基础域名与 ACME 证书申请配置 (Traefik 自带 ACME)
DOMAIN=roybi.net
ACME_EMAIL=someone@some.com
# 腾讯云 API 密钥 (用于 Traefik ACME DNS-01 泛域名证书自动签发)
TENCENTCLOUD_SECRET_ID=your_tencentcloud_secret_id
TENCENTCLOUD_SECRET_KEY=your_tencentcloud_secret_key


# 业务域名配置 (统一经由 Traefik 443 端口进行 HTTPS 访问)
SEAFILE_HOST=pan.roybi.net
JELLYFIN_HOST=media.roybi.net
PHOTO_HOST=photo.roybi.net
FILES_HOST=files.roybi.net
ARIANG_HOST=aria.roybi.net
QBITTORRENT_HOST=qb.roybi.net

# ==============================================================================
# 端口配置
# ==============================================================================
# 【网关端口 (Traefik)】
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
JELLYFIN_HTTPS_PORT=8920           # 历史 8920 HTTPS 端口（Traefik 自动 301 重定向至 443）
# Traefik 本地管理面板端口 (仅绑定 127.0.0.1)
TRAEFIK_DASHBOARD_PORT=8080

# 【本地与传输端口】
# (注：Seafile、PhotoPrism、Jellyfin、Nginx、AriaNg 业务均已纯走 Traefik 二级域名 HTTPS，不再开放独立 HTTP 端口)
MINIO_PORT=9000            # MinIO S3 API 端口 (仅 127.0.0.1)
MINIO_CONSOLE_PORT=9001    # MinIO 控制台端口 (仅 127.0.0.1)
ARIA2_RPC_PORT=6800        # Aria2 RPC 端口 (仅 127.0.0.1)
ARIA2_BT_PORT=6881         # Aria2 BT 下载监听端口 (TCP/UDP)
QBITTORRENT_WEB_PORT=8085  # qBittorrent WebUI 本地端口 (容器内 WEBUI_PORT 同步为 8085，避开 8080)
QBITTORRENT_BT_PORT=56881   # qBittorrent BT 下载监听端口 (避开 Aria2 的 6881)

# 数据存储目录配置
SEAFILE_DATA_DIR=./data/seafile/data
DB_DATA_DIR=./data/mysql/db
ES_DATA_DIR=./data/elasticsearch
HTML_DATA_DIR=./data/html
DOWNLOAD_DATA_DIR=./data/downloads
NGINX_DATA_DIR=./data/nginx
ARIA2_DATA_DIR=./data/aria2
QBITTORRENT_DATA_DIR=./data/qbittorrent
JELLYFIN_DATA_DIR=./data/jellyfin
JELLYFIN_MEDIA_DIR=./data/minio/jellyfin

# Rclone 挂载源与缓存路径
RCLONE_MOUNT_DIR=./data/minio
RCLONE_CACHE_DIR=./data/rclone_cache
RCLONE_CONF_PATH=./rclone/rclone.conf

# PhotoPrism 业务目录 (对齐 Rclone life 挂载)
PHOTOPRISM_ORIGINALS_DIR=./data/minio/life
PHOTOPRISM_STORAGE_DIR=./data/photoprism/storage
PHOTOPRISM_IMPORT_DIR=./data/photoprism/import

DB_HOST=db
DB_ROOT_PASSWD=123456
TIME_ZONE=Asia/Shanghai
SEAFILE_ADMIN_EMAIL=someone@some.com
SEAFILE_ADMIN_PASSWORD=12345
SEAFILE_SERVER_LETSENCRYPT=false
SEAFILE_SERVER_HOSTNAME=pan.roybi.net

# Aria2 RPC 访问密钥
ARIA2_SECRET=your_aria2_secret_token

# PhotoPrism 管理员账户与数据库凭据
PHOTOPRISM_ADMIN_USER=admin
PHOTOPRISM_ADMIN_PASSWORD=your_photoprism_admin_password
PHOTOPRISM_DATABASE_NAME=photoprism
PHOTOPRISM_DATABASE_USER=root
PHOTOPRISM_DATABASE_PASSWORD=your_db_password_here

MINIO_ROOT_USER=minio1
MINIO_ROOT_PASSWORD=minio123

# minio数据持久化挂载路径
data1=./data/data1-1
data2=./data/data1-2
data3=./data/data2-1
data4=./data/data2-2

# Rclone S3 子账号凭据 (life 和 media 独立账号)
RCLONE_CONFIG_LIFE_ACCESS_KEY_ID=your_life_access_key
RCLONE_CONFIG_LIFE_SECRET_ACCESS_KEY=your_life_secret_key
RCLONE_CONFIG_MEDIA_ACCESS_KEY_ID=your_media_access_key
RCLONE_CONFIG_MEDIA_SECRET_ACCESS_KEY=your_media_secret_key

